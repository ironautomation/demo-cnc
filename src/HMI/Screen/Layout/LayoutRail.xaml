<Canvas
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:opc="clr-namespace:IronHMI.OpcUaBridge;assembly=IronHMI.OpcUaBridge"
    xmlns:action="clr-namespace:IronHMI.Actions;assembly=IronHMI.Common"
    xmlns:access="clr-namespace:IronHMI.Controls.Abstractions;assembly=IronHMI.Controls.Abstractions"
    xmlns:ironControls="clr-namespace:IronControls;assembly=IronControls"
    xmlns:cnc="clr-namespace:CncControls;assembly=CncControls"
    Width="144"
    Height="1080"
    Background="{DynamicResource Bg}">
    <!-- 가로판 우측 레일(NavRegion 1776,0 · 144×1080) — R안. 위에서부터 장비 · 운전 상태 · 알람 · 화면 네비 · 시계 · 로그인 · 종료.
         좌표는 레일 기준이고 가운데 정렬 축은 x=72.
         네비: 회색 세로 트랙 하나 안에 5칸(아이콘 위 · 라벨 아래), 선택 칸만 흰 알약으로 떠오른다. 칸 사이 틈 4 까지 트랙 전체가 누르는 자리.
         아래쪽은 작업 화면 운전 명령 줄(936..1056)에 맞춘다: 로그인 위 = 936, 종료 아래 = 1056(아래 여백 24).
         터치 패널 전제라 hover 효과는 두지 않는다(손가락이 떠난 뒤에도 hover 가 남는다). 눌림 = 살짝 축소/흐림. -->

    <Canvas.Resources>
        <!-- 네비 칸. 아이콘 선 색은 Button.Tag 로 받는다 — 선택 시 트리거가 Tag 를 브랜드 색으로 바꾼다. -->
        <Style x:Key="SegTab" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Tag" Value="{DynamicResource Fg3}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegBody" Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="action:HmiNavigation.IsTargetActive" Value="True">
                                <Setter TargetName="SegBody" Property="Background" Value="{DynamicResource Bg}" />
                                <Setter TargetName="SegBody" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270"
                                                          Color="#0B1220" Opacity="0.12" />
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Tag" Value="{DynamicResource BrandPressed}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- 프로그램 종료. 로그인 버튼과 같은 크기 · 외곽선(흰 바탕 · BorderStrong · 모서리 8), 글자 · 아이콘만 DangerFg —
             빨강 채움은 운전 명령의 정지 버튼 몫이라 쓰지 않는다. 눌림은 LoginButton 과 같은 흐림 단계. -->
        <Style x:Key="RailExit" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource DangerFg}" />
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Canvas.Resources>

    <!-- 레일 바탕 + 작업 화면과의 경계(왼쪽 1px) -->
    <Border Canvas.Left="0" Canvas.Top="0" Width="144" Height="1080"
            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" />

    <!-- ===== 장비 ===== -->
    <!-- IRON AUTOMATION 로고(Images/IronLogo.png, 1280×436) — 레일 안쪽 폭 120 에 맞춰 높이 41 -->
    <Image Canvas.Left="12" Canvas.Top="26" Width="120" Height="41" Stretch="Uniform"
           Source="Images/IronLogo.png" />
    <!-- 장비 이름 두 줄 — Config\Machine.xml 의 이름(기본 「범용 CNC」) · Config\Heads.xml 의 장착 헤드 -->
    <cnc:MachineTitle Canvas.Left="4" Canvas.Top="76" Width="136" Height="44" NameSize="16" SubSize="11" ShowProduct="False" Align="Center"
        MachineFile="Config\Machine.xml" HeadsFile="Config\Heads.xml" />

    <!-- 운전 상태·메시지 칩(세로판 헤더와 같은 바인딩) — 레일 폭 120 에 맞춘 두 줄: 위 ● 상태, 아래 자동 · 메시지(말줄임).
         높이 32 → 56 이라 알람 버튼이 204 로 내려간다. 비상정지는 PLC 가 보는 유일한 입력인 핸드휠(MPG) EMS(DI_MPG_Jog_EMS1, NC · TRUE = 해제);
         래치(Output.Status.EmergencyStop)는 알람 90 으로 나온다.
         자동/수동은 gEquipment.Input.Command.ManualMode(수동조작 창 모드 칩)에서 오고 ModeTag(Output.Status.Mode)로 보인다.
         누르면 칩 오른쪽 위 모서리를 기준으로 왼쪽 · 아래로 600×592 상세 카드: 알람마다 처음 본 시각 · 위치 · 값(축 ErrorID · CNC StatusID) ·
         원인 · 조치(alarms.json 정의) · 리셋(축 = Axis_RESET · 그 밖 = CncCommand RESET, 등급 10 · 확인) · 작업기록 알람 보기. -->
    <cnc:RunStateChip Canvas.Left="12" Canvas.Top="136" Width="120" Height="56"
        opc:OpcUaNode.ConnectionId="cnc-plc" Layout="Stack"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        ModeTag="::AsGlobalPV:gEquipment.Output.Status.Mode"
        InitializedTag="::AsGlobalPV:gEquipment.Output.State.Initialized"
        ProgramTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        CurrentLineTag="::AsGlobalPV:C_CurrentLine"
        EStopTag="::AsGlobalPV:DI_MPG_Jog_EMS1" EStopLabel="핸드휠 비상정지"
        MpgEnableTag="::AsGlobalPV:DI_MPG_Jog_Enable"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        DryRunTag="::AsGlobalPV:gEquipment.Input.Parameter.DryRun"
        CncFolderFile="Config\CncFolder.xml" HeadsFile="Config\Heads.xml" HeadUsageFile="Database\HeadUsage.xml"
        AlarmsFile="alarms.json"
        XErrorIdTag="::AsGlobalPV:gAxis[0].Output.State.ErrorID" YErrorIdTag="::AsGlobalPV:gAxis[1].Output.State.ErrorID" ZErrorIdTag="::AsGlobalPV:gAxis[2].Output.State.ErrorID"
        StatusIdTag="::AsGlobalPV:gEquipment.Output.Status.StatusID" CncCommandTag="::AsGlobalPV:gEquipment.Input.CncCommand" AxisPrefix="::AsGlobalPV:gAxis[{0}]"
        ResetAccessLevel="10" RecordPanelId="Panel_Record" ErrorCodesFile="Config\ErrorCodes.xml"
        DetailWidth="600" DetailHeight="592"
        LabelSize="12" DotSize="6" />

    <!-- 자동/수동 전환 — 알람 위. 지금 모드 = Output.Status.Mode, 다른 칸을 누르면 확인 뒤 Input.Command.ManualMode 에 쓴다
         (PLC 는 CNC 가 쉬고 있을 때만 받는다 — 운전 중에는 막고 사유를 띄운다). 수동조작 창의 모드 칩과 같은 변수. 상태 칩 아래 12 -->
    <cnc:ModeToggle Canvas.Left="12" Canvas.Top="204" Width="120" Height="44"
        access:Access.Level="10"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        ModeTag="::AsGlobalPV:gEquipment.Output.Status.Mode"
        ModeCommandTag="::AsGlobalPV:gEquipment.Input.Command.ManualMode" ModeCommandTrueIsManual="True"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        LabelSize="14" />

    <!-- 알람 — 엔진 AlarmControl 배지 모드(활성 건수 + 깜빡임, 누르면 알람 창). 자동/수동 아래 8 -->
    <ironControls:AlarmControl Canvas.Left="12" Canvas.Top="256" Width="120" Height="44"
        access:Access.Level="10"
        BadgeStyle="True" BadgeText="알람" />

    <!-- ===== 네비 B 세로: 세그먼트 트랙 (12,312 · 120×528, 안쪽 여백 6 · 칸 108×100 · 간격 4) ===== -->
    <Border Canvas.Left="12" Canvas.Top="312" Width="120" Height="528" CornerRadius="18" Background="#E6EAF0" />

    <Button Canvas.Left="18" Canvas.Top="318" Width="108" Height="100" Style="{StaticResource SegTab}"
            action:HmiNavigation.TargetPanelId="Panel_Job">
        <StackPanel>
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Rectangle Canvas.Left="3" Canvas.Top="3" Width="7" Height="7" RadiusX="1" RadiusY="1" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Canvas.Left="14" Canvas.Top="3" Width="7" Height="7" RadiusX="1" RadiusY="1" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Canvas.Left="14" Canvas.Top="14" Width="7" Height="7" RadiusX="1" RadiusY="1" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Canvas.Left="3" Canvas.Top="14" Width="7" Height="7" RadiusX="1" RadiusY="1" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{StaticResource SegLabel}" Text="작업현황" />
        </StackPanel>
    </Button>

    <Button Canvas.Left="18" Canvas.Top="422" Width="108" Height="100" Style="{StaticResource SegTab}"
            action:HmiNavigation.TargetPanelId="Panel_IO">
        <StackPanel>
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="16" Height="16" RadiusX="2" RadiusY="2" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Rectangle Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" StrokeThickness="1.75"
                               Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Path StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M15,2 V4 M15,20 V22 M2,15 H4 M2,9 H4 M20,15 H22 M20,9 H22 M9,2 V4 M9,20 V22" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{StaticResource SegLabel}" Text="I/O 확인" />
        </StackPanel>
    </Button>

    <Button Canvas.Left="18" Canvas.Top="526" Width="108" Height="100" Style="{StaticResource SegTab}"
            action:HmiNavigation.TargetPanelId="Panel_Config">
        <StackPanel>
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path StrokeThickness="1.75" StrokeLineJoin="Round"
                          Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12.22,2 h-0.44 a2,2 0 0 0 -2,2 v0.18 a2,2 0 0 1 -1,1.73 l-0.43,0.25 a2,2 0 0 1 -2,0 l-0.15,-0.08 a2,2 0 0 0 -2.73,0.73 l-0.22,0.38 a2,2 0 0 0 0.73,2.73 l0.15,0.1 a2,2 0 0 1 1,1.72 v0.51 a2,2 0 0 1 -1,1.74 l-0.15,0.09 a2,2 0 0 0 -0.73,2.73 l0.22,0.38 a2,2 0 0 0 2.73,0.73 l0.15,-0.08 a2,2 0 0 1 2,0 l0.43,0.25 a2,2 0 0 1 1,1.73 V20 a2,2 0 0 0 2,2 h0.44 a2,2 0 0 0 2,-2 v-0.18 a2,2 0 0 1 1,-1.73 l0.43,-0.25 a2,2 0 0 1 2,0 l0.15,0.08 a2,2 0 0 0 2.73,-0.73 l0.22,-0.39 a2,2 0 0 0 -0.73,-2.73 l-0.15,-0.08 a2,2 0 0 1 -1,-1.74 v-0.5 a2,2 0 0 1 1,-1.74 l0.15,-0.09 a2,2 0 0 0 0.73,-2.73 l-0.22,-0.38 a2,2 0 0 0 -2.73,-0.73 l-0.15,0.08 a2,2 0 0 1 -2,0 l-0.43,-0.25 a2,2 0 0 1 -1,-1.73 V4 a2,2 0 0 0 -2,-2 Z" />
                    <Ellipse Canvas.Left="9" Canvas.Top="9" Width="6" Height="6" StrokeThickness="1.75"
                             Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{StaticResource SegLabel}" Text="구성설정" />
        </StackPanel>
    </Button>

    <Button Canvas.Left="18" Canvas.Top="630" Width="108" Height="100" Style="{StaticResource SegTab}"
            action:HmiNavigation.TargetPanelId="Panel_Record">
        <StackPanel>
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12,20 V10 M18,20 V4 M6,20 V16" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{StaticResource SegLabel}" Text="작업기록" />
        </StackPanel>
    </Button>

    <Button Canvas.Left="18" Canvas.Top="734" Width="108" Height="100" Style="{StaticResource SegTab}"
            action:HmiNavigation.TargetPanelId="Panel_History">
        <StackPanel>
            <Viewbox Width="26" Height="26" HorizontalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" StrokeThickness="1.75"
                             Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Path StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12,7 V12 L15,14" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{StaticResource SegLabel}" Text="작업이력" />
        </StackPanel>
    </Button>

    <!-- ===== 아래: 시계 · 로그인 · 종료 (트랙 끝 840 아래, 작업 화면 운전 명령 줄 936..1056 에 맞춤) ===== -->
    <ironControls:TimeBox Canvas.Left="12" Canvas.Top="896" Width="120" Height="24"
        Format="HH:mm:ss' KST'"
        FontFamily="{DynamicResource MonoFont}" FontSize="16" FontWeight="Medium"
        Foreground="{DynamicResource Fg2}" Background="Transparent" />

    <!-- 로그인 / 로그아웃 -->
    <ironControls:LoginButton Canvas.Left="12" Canvas.Top="936" Width="120" Height="52"
        LoginText="로그인" LogoutText="로그아웃"
        Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderStrong}"
        FontFamily="{DynamicResource UiFont}" FontSize="14" FontWeight="Medium"
        Foreground="{DynamicResource Fg2}" />

    <!-- 프로그램 종료 — 런타임이 「종료할까요?」 예/아니오 확인 창을 띄운 뒤 닫는다(로그인 아래 16) -->
    <Button Canvas.Left="12" Canvas.Top="1004" Width="120" Height="52" Style="{StaticResource RailExit}"
            action:HmiApplication.ExitOnClick="True">
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Stroke="{DynamicResource DangerFg}" StrokeThickness="2.1" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Data="M12 3.5v8 M6.3 6.8a8 8 0 1 0 11.4 0" />
                </Canvas>
            </Viewbox>
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="종료" />
        </StackPanel>
    </Button>
</Canvas>
