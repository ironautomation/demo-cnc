<?xml version="1.0" encoding="utf-8"?>
<!-- 헤드 테이블 — 장착된 헤드마다 한 줄. X/Y/Z = 기준 헤드(Reference) 끝에서의 오프셋(mm, 기계 좌표: X+ = 긴 레일의 모터 반대쪽 · Y+ = 빔 위 트랙 쪽 · Z+ 아래 — 2026-10-13 현장 확인).
     Type = Dispenser | Laser | Other, Param = 종류별 값. Mounted="false" = 구성설정 「헤드 구성 바꾸기」로 뺀 헤드(값은 남김, 다시 달면 이어짐).
     3D 레이저 위치가 레이저 헤드 오프셋을 쓴다. 구성설정에서 바꾸면 HMI 가 다시 쓴다(헤드 구성을 바꾸면 이전 파일은 Heads.bak.xml).
     2026-10-16 부터 레이저만 단 구성: 레이저(H2)가 기준 헤드(오프셋 0 — 3D 모델의 기준점이 레이저 출사구), 디스펜서(H1)는
     「헤드 구성 바꾸기」로 뺀 상태(값은 보관 — 예전 구성에서 디스펜서 니들은 레이저 출사구 기준 빔 방향 +60 · 높이 −17). -->
<Heads>
  <Head Id="H1" Name="디스펜서" Type="Dispenser" X="0" Y="60" Z="17" Mounted="false" />
  <Head Id="H2" Name="레이저" Type="Laser" X="0" Y="0" Z="0" Reference="true">
    <Param Key="ManualPower" Value="10" />
  </Head>
</Heads>
