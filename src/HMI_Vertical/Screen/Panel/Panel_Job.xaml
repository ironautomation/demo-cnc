<Canvas
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:opc="clr-namespace:IronHMI.OpcUaBridge;assembly=IronHMI.OpcUaBridge"
    xmlns:action="clr-namespace:IronHMI.Actions;assembly=IronHMI.Common"
    xmlns:access="clr-namespace:IronHMI.Controls.Abstractions;assembly=IronHMI.Controls.Abstractions"
    xmlns:cnc="clr-namespace:CncControls;assembly=CncControls"
    Width="1080"
    Height="1720"
    Background="{DynamicResource Surface1}">
    <!-- 작업현황(2026-10-12). 리전 y=200 기준 배치:
         3D 532 · 프로그램 카드 260(파일 · 진행 · G코드 스크롤 · 줄 단위 실행) · 운전 명령 + 속도 배율 96 · 축 콕핏 360 · 트렌드/생산 156 · 타일 2줄 204, 간격 16 · 좌우 여백 24.
         떠 있는 창(수동조작 · 시뮬레이션) · 가공 파일 창 · 트렌드 상세 · 시뮬 리포트는 이 패널 안 오버레이. 조작(조그 · 원점 · 서보 · 헤드 출력)은 수동조작 창 한 곳. -->

    <Canvas.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width" Value="107" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="AxisLetter" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="RowLine" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>
    </Canvas.Resources>

    <!-- 화면 클릭 감사 로그(작업기록 「화면 이벤트」) -->
    <cnc:GuiClickLogger ScreenName="Job" LogFolder="Logs\Event" />
    <!-- 연속 운전 자동 시작(비가시, 2026-10-19) — 가공 파일 창 「연속 운전」으로 올린 순서(ProgramQueue)를 돌린다: 앞 파일이 「완료」로 끝나면
         다음 파일 이름을 sProgramName 에 쓰고 PLC 가 쉬면 CncCommand 2. 파일마다 반복 ×n · ∞, 정지 · 에러면 멈추고 프로그램 카드에서 이어 갈 방법을 고른다.
         마지막 순서는 Database\ProgramQueue.xml. -->
    <cnc:ProgramQueueRunner opc:OpcUaNode.ConnectionId="cnc-plc"
        ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        CommandTag="::AsGlobalPV:gEquipment.Input.CncCommand"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        QueueFile="Database\ProgramQueue.xml" CncFolderFile="Config\CncFolder.xml" />
    <!-- 작업 이력 기록기(비가시) — 운전 1회마다 Database\jobhistory.db 에 한 줄(작업이력 화면이 읽는다) + 블랙박스(3D 가 그린 샘플 ·
         라인 진입 · 토크 100ms · 머신 속도 · 그때의 가공 파일 본문)를 같은 트랜잭션으로. 작업이력 행 클릭 → 재생. 보존 180일. -->
    <cnc:CncJobRecorder opc:OpcUaNode.ConnectionId="cnc-plc" DbPath="Database\jobhistory.db"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        ProgramTag="::AsGlobalPV:gEquipment.Output.Status.WorkPanelName"
        ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        CurrentLineTag="::AsGlobalPV:C_CurrentLine"
        RuntimeTag="::AsGlobalPV:C_OverallRuntime"
        DryRunTag="::AsGlobalPV:gEquipment.Input.Parameter.DryRun"
        TorqueXTag="::AsGlobalPV:Torque_X"
        TorqueYTag="::AsGlobalPV:Torque_Y"
        TorqueZTag="::AsGlobalPV:Torque_Z"
        CncFolderFile="Config\CncFolder.xml"
        DetailRetentionDays="180" />

    <!-- ===== 3D 트윈 (24,8 · 1032×532) — 뷰 3종 · 비드 · 계획 점선. 파일 이름 · 파일 버튼 · 코드 버튼 · 진행 막대는 아래 프로그램 카드로 옮겨
         ShowProgramChrome="False"(G코드 선택을 3D 밖으로). 비드 = PLC 링버퍼(BufferHeadOn = 헤드 켜짐), 자국 · 음영 · 빔은 지금 헤드 플러그인이 그린다(헤드 값 링버퍼 · 태그도 그 플러그인이 알림).
         모델은 실장비 STEP 변환 — 노드 이름(GantryX/Y/Z · Nozzle)을 지킨다. 뷰포트 좌상단 모서리를 두 번 누르면 구도 설정창. ===== -->
    <cnc:CncDispense3DControl x:Name="Twin" Canvas.Left="24" Canvas.Top="8" Width="1032" Height="532"
        ShowProgramChrome="False"
        HeadsFile="Config\Heads.xml" HeadUsageFile="Database\HeadUsage.xml"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        ModelPath="Models\cnc_gantry.glb"
        ViewSettingsFile="Config\View3D.xml"
        GCodeConfigFile="Config\GCode.xml"
        CncFolderFile="Config\CncFolder.xml"
        AxisXTag="::AsGlobalPV:gAxis[0].Output.State.Position"
        AxisYTag="::AsGlobalPV:gAxis[1].Output.State.Position"
        AxisZTag="::AsGlobalPV:gAxis[2].Output.State.Position"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        DryRunTag="::AsGlobalPV:gEquipment.Input.Parameter.DryRun"
        RingBufferHeadTag="::RingBuffer:Head"
        RingBufferXTag="::RingBuffer:BufferX"
        RingBufferYTag="::RingBuffer:BufferY"
        RingBufferZTag="::RingBuffer:BufferZ"
        RingBufferHeadOnTag="::RingBuffer:BufferHeadOn"
        RingBufferMovingTag="::RingBuffer:BufferMoving"
        ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        WorkProgramTag="::AsGlobalPV:gEquipment.Output.Status.WorkPanelName"
        CurrentLineTag="::AsGlobalPV:C_CurrentLine"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        LimitNegXTag="::AsGlobalPV:gAxis[0].Input.Parameter.SoftwareLimitsNeg" LimitPosXTag="::AsGlobalPV:gAxis[0].Input.Parameter.SoftwareLimitsPos"
        LimitNegYTag="::AsGlobalPV:gAxis[1].Input.Parameter.SoftwareLimitsNeg" LimitPosYTag="::AsGlobalPV:gAxis[1].Input.Parameter.SoftwareLimitsPos"
        LimitNegZTag="::AsGlobalPV:gAxis[2].Input.Parameter.SoftwareLimitsNeg" LimitPosZTag="::AsGlobalPV:gAxis[2].Input.Parameter.SoftwareLimitsPos"
        SingleStepTag="::AsGlobalPV:gCncRun.Input.SingleStep" OptionalStopTag="::AsGlobalPV:gCncRun.Input.OptionalStop" StartLineTag="::AsGlobalPV:gCncRun.Input.StartLine" StartAtLineCommand="15"
        CncCommandTag="::AsGlobalPV:gEquipment.Input.CncCommand"
        AxisLimits="X:-5:450;Y:-5:430;Z:-5:145"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        ShadeValues="True" />

    <!-- 모듈 장비(플러그인, 구성설정 › 플러그인에서 켬): 3D 모델 · 움직이는 노드 · 태그는
         모듈 플러그인이 알리고(SDK 1.2.0 IModuleScene · IModuleMotion) 3D 가 붙이고 · 구독하고 · 그린다. -->

    <!-- ===== 프로그램 카드 (24,556 · 1032×260) — 머리: 파일 이름 · 줄 / 전체 · 진행 · 남은 시간 · 「프로그램 선택」(가공 파일 창).
         왼쪽: G코드 전체 — 끌기 · 휠 · 스크롤 막대로 굴리고 줄을 누르면 고름(굴리면 따라가기 멈춤), 헤드 켜진 줄 왼쪽 띠, 운전 중 CNC 에러 줄 빨강.
         오른쪽(232): 한 줄씩 실행 · M01 정지 · 이 줄부터 시작 · 현재 줄로(예전 3D 「코드」 패널). PLC 비보관 전역 gCncRun(2026-11-02 —
         RETAIN gEquipment 대신): Input.SingleStep · Input.OptionalStop(BOOL), Input.StartLine(UDINT 파일 줄) → CncCommand 15, 운전 명령 막대는
         Output.SingleStepActive 로 「다음 줄」. PLC 를 켤 때마다 둘 다 꺼진다(비보관). ===== -->
    <cnc:ProgramPanel Canvas.Left="24" Canvas.Top="556" Width="1032" Height="260"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        WorkProgramTag="::AsGlobalPV:gEquipment.Output.Status.WorkPanelName"
        CurrentLineTag="::AsGlobalPV:C_CurrentLine"
        RuntimeTag="::AsGlobalPV:C_OverallRuntime"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        ProgramInterruptedTag="::AsGlobalPV:gEquipment.Output.Status.ProgramInterrupted"
        ErrorTag="::AsGlobalPV:gEquipment.Output.Status.Error"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        CncCommandTag="::AsGlobalPV:gEquipment.Input.CncCommand"
        SingleStepTag="::AsGlobalPV:gCncRun.Input.SingleStep" OptionalStopTag="::AsGlobalPV:gCncRun.Input.OptionalStop" StartLineTag="::AsGlobalPV:gCncRun.Input.StartLine" StartAtLineCommand="15" RunModeAccessLevel="10"
        CncFolderFile="Config\CncFolder.xml" GCodeConfigFile="Config\GCode.xml" VisibleLines="5" SideWidth="232"
        ProductionTargetFile="Config\Production.xml" JobDbPath="Database\jobhistory.db" />

    <!-- ===== 운전 명령 (24,832 · 700×96) + 속도 배율 (736,832 · 320×96, 한 줄) — 속도 배율 = 피드 오버라이드(G00 급속 제외),
         gEquipment.Input.Parameter.Feedrate(%) · −/+ 10 · 값을 길게 누르면 100 · 운전 명령과 같은 등급 10 ===== -->
    <cnc:CncCommandBar Canvas.Left="24" Canvas.Top="832" Width="700" Height="96"
        access:Access.Level="10"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        CommandTag="::AsGlobalPV:gEquipment.Input.CncCommand"
        CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        ProgramInterruptedTag="::AsGlobalPV:gEquipment.Output.Status.ProgramInterrupted"
        SingleStepActiveTag="::AsGlobalPV:gCncRun.Output.SingleStepActive"
        ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName" />
    <cnc:FeedOverrideBox Canvas.Left="736" Canvas.Top="832" Width="320" Height="96" Layout="Row"
        access:Access.Level="10"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        FeedrateTag="::AsGlobalPV:gEquipment.Input.Parameter.Feedrate" Min="10" Max="150" />

    <!-- ===== 축 콕핏 (24,944 · 1032×260) — 축 한 줄에 기계 위치 · 추이 · 속도(mm/min) · −리밋 · 홈 · +리밋 | 서보 · 원점 · 알람 · 토크. 보기 전용(조작은 수동조작 창).
         줄 높이를 줄여 아래를 플러그인 영역에 내줬다. 리밋 · 홈 센서 = gDS402_X/Y/Z.DigitalInputs(읽기 전용 공개 —
         리밋은 B접점). ===== -->
    <cnc:AxisCockpit Canvas.Left="24" Canvas.Top="944" Width="1032" Height="260"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        AxisStateTag="::AsGlobalPV:gAxis[{0}].Output.State"
        TorqueTag="::AsGlobalPV:Torque_{1}"
        LimitNegTag="::AsGlobalPV:gDS402_{1}.DigitalInputs.NegativeLimitSwitch"
        HomeSwitchTag="::AsGlobalPV:gDS402_{1}.DigitalInputs.HomingSwitch"
        LimitPosTag="::AsGlobalPV:gDS402_{1}.DigitalInputs.PositiveLimitSwitch"
        EStopTag="::AsGlobalPV:gEquipment.Output.Status.EmergencyStop" />

    <!-- ===== 플러그인 영역 (24,1216 · 1032×396, 4 × 4 칸 249×90 · 사이 12) — 지난 머신 속도 · 오늘 생산 카드 자리. 쓰는 헤드의 배치(Config\PluginLayout.xml —
         구성설정 › 플러그인 › 플러그인 배치)대로 플러그인 카드를 놓는다(틀 = HMI · 몸통 = 플러그인). 배치가 없으면 점선 + 「플러그인 배치 ›」(권한 10).
         헤드 카드 「›」 = 트렌드 상세. 오늘 생산은 프로그램 카드 머리줄 칩, 헤드 출력 칸은 없앴다(헤드는 하나 — 헤드 카드가 보인다) ===== -->
    <cnc:PluginArea Canvas.Left="24" Canvas.Top="1216" Width="1032" Height="396" Portrait="True"
        opc:OpcUaNode.ConnectionId="cnc-plc" LayoutFile="Config\PluginLayout.xml" HeadsFile="Config\Heads.xml"
        SheetName="TrendSheet" ConfigPanelId="Panel_Config" LayoutAccessLevel="10" />

    <!-- 머신 속도 수집(보이지 않음) — 작업 트렌드(작업 전체 · 헤드 값 · 지금 줄 — 헤드 카드 「›」 = 그 헤드 플러그인 화면)와 플러그인 카드 트렌드(머신 속도)가 이 표본을 쓴다.
         PLC 가 경로 속도를 내보내지 않아 √(Vx²+Vy²+Vz²)×60 -->
    <cnc:TrendCard Visibility="Collapsed" Width="508" Height="156"
        opc:OpcUaNode.ConnectionId="cnc-plc"
        SignalId="feed" Title="머신 속도" Subtitle="경로 속도 · 작업 시작부터" Icon="Feed"
        Unit="mm/min" Decimals="0" MaxValue="12000" WarnRatio="0.8" Mode="PathSpeed"
        SpeedXTag="::AsGlobalPV:gAxis[0].Output.State.Speed"
        SpeedYTag="::AsGlobalPV:gAxis[1].Output.State.Speed"
        SpeedZTag="::AsGlobalPV:gAxis[2].Output.State.Speed"
        MovingTag="::AsGlobalPV:gEquipment.Output.State.Move"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive"
        ShowHeadValue="True"
        LineTag="::AsGlobalPV:C_CurrentLine" HeadsFile="Config\Heads.xml"
        SheetName="TrendSheet" />

    <!-- ===== 버튼 칸 (24,1624 · 1032×80 한 줄) — 작업 진행(300, 대기 예상 · 운전 중 잔여 · 끝 시각 · % · 일시정지 · 완료 소요) · 원점 복귀 · 대기 위치 · 수동조작 ·
         시뮬레이션 · 드라이런(134.4, 사이 12) — 설명 없이 아이콘 위 · 이름 아래. 원점 복귀 = CncCommand 8(Z → X·Y),
         대기 위치 = Config\TeachPositions.xml 의 위치로 ManualPositon + ManualMove(수동 모드에서만), 드라이런 = 한 칸으로 켜고 끈다(켜지면 옅은 파랑) ===== -->
    <cnc:JobProgressTile Canvas.Left="24" Canvas.Top="1624" Width="300" Height="80" opc:OpcUaNode.ConnectionId="cnc-plc" MaxHeads="1" HeadsFile="Config\Heads.xml"
        ProgramActiveTag="::AsGlobalPV:gEquipment.Output.Status.ProgramActive" ProgramInterruptedTag="::AsGlobalPV:gEquipment.Output.Status.ProgramInterrupted"
        CompleteTag="::AsGlobalPV:gEquipment.Output.State.Complete" ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName"
        WorkProgramTag="::AsGlobalPV:gEquipment.Output.Status.WorkPanelName" />
    <cnc:ActionTile Canvas.Left="336" Canvas.Top="1624" Width="134.4" Height="80" Compact="True"
        access:Access.Level="10" opc:OpcUaNode.ConnectionId="cnc-plc"
        Title="원점 복귀" Subtitle="Z → X·Y" DisabledSubtitle="다른 명령 진행 중" Icon="Home"
        WriteTag="::AsGlobalPV:gEquipment.Input.CncCommand" WriteData="8" RequireIdle="True"
        ConfirmText="원점 복귀를 시작합니다 — Z 먼저, 그다음 X·Y.&#10;축 주변에 사람이나 공구가 없는지 확인하십시오." />
    <cnc:ActionTile Canvas.Left="482.4" Canvas.Top="1624" Width="134.4" Height="80" Compact="True"
        access:Access.Level="10" opc:OpcUaNode.ConnectionId="cnc-plc"
        Title="대기 위치" Subtitle="대기 위치로 이동" DisabledSubtitle="수동 모드에서만" Icon="Crosshair"
        TeachKey="ReadyPosition" TeachFile="Config\TeachPositions.xml" MoveMaxSpeed="200" AxisLimits="X:-5:450;Y:-5:430;Z:-5:145"
        EnableTag="::AsGlobalPV:gEquipment.Output.Status.Mode" EnableValue="false" RequireIdle="True" />
    <cnc:ActionTile Canvas.Left="628.8" Canvas.Top="1624" Width="134.4" Height="80" Compact="True"
        access:Access.Level="10"
        Title="수동조작" Subtitle="조그 · 축 · 헤드" Icon="Move"
        ShowTargets="ManualPanel" HideTargets="SimPanel" />
    <cnc:ActionTile Canvas.Left="775.2" Canvas.Top="1624" Width="134.4" Height="80" Compact="True"
        access:Access.Level="10"
        Title="시뮬레이션" Subtitle="실행 전 경로 점검" Icon="Box"
        ShowTargets="SimPanel" HideTargets="ManualPanel" />
    <cnc:ActionTile Canvas.Left="921.6" Canvas.Top="1624" Width="134.4" Height="80" Compact="True"
        access:Access.Level="10" opc:OpcUaNode.ConnectionId="cnc-plc"
        Title="드라이런" Subtitle="꺼짐" ActiveSubtitle="켜짐 · 출력 없이 경로만" Icon="DropletOff"
        WriteTag="::AsGlobalPV:gEquipment.Input.Parameter.DryRun" WriteData="true" ToggleWrite="True" OffData="false"
        StateTag="::AsGlobalPV:gEquipment.Input.Parameter.DryRun" StateValue="true" />

    <!-- ===== 떠 있는 창 2개 (평소 숨김) — 하나를 열면 다른 하나는 닫힌다. 시뮬레이션 (536,936 · 520×760)은 머리를 끌어 옮긴다. ===== -->
    <!-- 수동조작(Docked · DockColumns 4 — 2026-10-13): 축 콕핏 바로 아래 (24,1216 · 1032×488)에 고정으로 떠
         플러그인 영역 · 버튼 칸 자리를 덮는다 — 축 콕핏 · 3D · 프로그램 카드 · 운전 명령 · 속도 배율은 그대로 보인다. 네 칸: 조그(이동 = 연속 / 0.001 ~ 1 mm,
         조이스틱 · Z 레버 · 속도 mm/min) | 축(X · Y · Z · 전체 + 원점 복귀 · 서보 ON/OFF · 리셋) | 지정 위치(이동 · 저장, 값은 Config\TeachPositions.xml) |
         헤드(이름 칸 = PLC 실제 출력) · MDI(sBlock + CncCommand 14), 정지(CncCommand 4 + 세 축 HALT + 헤드 수동 출력 끔, 비상정지 회로 아님)는 오른쪽 세 칸 아래.
         기계 좌표 칸 없음(축 콕핏에 보임), 끌기 없음 — 닫기 X 로 닫는다. 핸드휠 사용 중이면 잠금. -->
    <cnc:ManualPanel x:Name="ManualPanel" Canvas.Left="24" Canvas.Top="1216" Width="1032" Height="488" Docked="True" DockColumns="4"
        MachineFile="Config\Machine.xml" HeadsFile="Config\Heads.xml"
