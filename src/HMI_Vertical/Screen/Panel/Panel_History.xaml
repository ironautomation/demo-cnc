<Canvas
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:opc="clr-namespace:IronHMI.OpcUaBridge;assembly=IronHMI.OpcUaBridge"
    xmlns:action="clr-namespace:IronHMI.Actions;assembly=IronHMI.Common"
    xmlns:access="clr-namespace:IronHMI.Controls.Abstractions;assembly=IronHMI.Controls.Abstractions"
    xmlns:cnc="clr-namespace:CncControls;assembly=CncControls"
    Width="1080"
    Height="1720"
    Background="{DynamicResource Surface1}">
    <!-- 작업이력 — 작업현황의 CncJobRecorder 가 운전 1회마다 Database\jobhistory.db 에 남긴 줄. 작업별 / 프로그램별 합계 두 보기,
         날짜 범위 조회와 CSV 저장. (작업기록과 같은 HistoryViewControl, 소스만 Job/JobTotal)
         작업별 보기의 행을 누르면 같은 화면 안에서 작업 재생(블랙박스) 창이 오른쪽에서 열린다 — 3D 재생(작업현황과 같은 모델·구도) ·
         타임라인 · 축 위치/토크 · 이벤트 · 라인 표 · 토크/머신 속도 그래프. 「재생」 열의 ● = 블랙박스 행이 있는 작업(기록 기능 이후). -->
    <cnc:HistoryViewControl
        Canvas.Left="0" Canvas.Top="0" Width="1080" Height="1720"
        Title="작업 이력"
        ToggleStyle="Buttons"
        PrimaryLabel="작업별"
        SecondaryLabel="프로그램별 합계"
        PrimaryColumns="번호:60;시작:180;프로그램:*;연속:110;소요:100;라인:100;결과:70;드라이런:80;속도 평균/최고:150;작업자:90;재생:60"
        SecondaryColumns="프로그램:*;횟수:90;완료:90;총 소요:140;평균 소요:140"
        EnablePanelFilter="False"
        PrimarySource="Job"
        SecondarySource="JobTotal"
        JobDbPath="Database\jobhistory.db"
        ReplayModelPath="Models\cnc_gantry.glb"
        ReplayViewSettingsFile="Config\View3D.xml"
        GCodeConfigFile="Config\GCode.xml"
        TorqueWarnLevel="0" />
</Canvas>
