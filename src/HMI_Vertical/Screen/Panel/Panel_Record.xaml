<Canvas
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:opc="clr-namespace:IronHMI.OpcUaBridge;assembly=IronHMI.OpcUaBridge"
    xmlns:action="clr-namespace:IronHMI.Actions;assembly=IronHMI.Common"
    xmlns:access="clr-namespace:IronHMI.Controls.Abstractions;assembly=IronHMI.Controls.Abstractions"
    xmlns:cnc="clr-namespace:CncControls;assembly=CncControls"
    Width="1080"
    Height="1720"
    Background="{DynamicResource Surface1}">
    <!-- 작업기록 — 알람 이력(엔진이 쓰는 Database\history.db 를 읽기만)과 화면 조작 이벤트(GuiClickLogger 가 쓰는 Logs\Event\*.log).
         날짜 범위로 찾고 CSV 로 저장한다. 삭제는 이벤트 로그 파일만(관리자 1회 인증). -->
    <cnc:HistoryViewControl
        Canvas.Left="0" Canvas.Top="0" Width="1080" Height="1720"
        Title="작업 기록"
        ToggleStyle="Buttons"
        PrimaryLabel="알람"
        SecondaryLabel="화면 이벤트"
        PrimaryColumns="번호:70;날짜:220;등급:90;알람ID:120;내용:*"
        SecondaryColumns="번호:70;날짜:220;화면:120;이벤트:120;내용:*"
        EnablePanelFilter="False"
        PrimarySource="Alarm"
        SecondarySource="Event"
        EventLogFolder="Logs\Event"
        DbPath="Database\history.db"
        AlarmsFile="alarms.json" />
</Canvas>
