<Canvas
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:opc="clr-namespace:IronHMI.OpcUaBridge;assembly=IronHMI.OpcUaBridge"
    xmlns:action="clr-namespace:IronHMI.Actions;assembly=IronHMI.Common"
    xmlns:access="clr-namespace:IronHMI.Controls.Abstractions;assembly=IronHMI.Controls.Abstractions"
    xmlns:ironControls="clr-namespace:IronControls;assembly=IronControls"
    xmlns:cnc="clr-namespace:CncControls;assembly=CncControls"
    Width="1080"
    Height="1720"
    Background="{DynamicResource Surface1}">
    <!-- 구성설정 — 속도·소프트 리밋은 PLC 값을 직접 고치고(값을 누르면 키패드, 입력 즉시 PLC 에 쓰기), 지정 위치는 HMI 파일(Config\TeachPositions.xml)에 쓴다. 이 파일은 생성기로 만들었다:
         왼쪽 네비 3칸 = [위치 · 속도] 지정 위치 · 속도/축 소프트 리밋 · 공작물 영점(PLC 대기) / [플러그인] 헤드 · 배치 · 추가 / [시스템] 장비 이름 · 정보 · 설정 내보내기. 레시피는 2026-10 PLC 개편으로 없다.
         편집 권한 Access.Level 5 — 운전자(10)는 보기만. 확정 전 사용자 확인 필요. -->
    <Canvas.Resources>
        <Style x:Key="Edit" TargetType="ironControls:AnalogBox">
            <Setter Property="opc:OpcUaNode.ConnectionId" Value="cnc-plc" />
            <Setter Property="access:Access.Level" Value="5" />
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Fg2}" />
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowHead" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Fg1}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Canvas.Resources>

    <cnc:GuiClickLogger ScreenName="Config" LogFolder="Logs\Event" />

    <!-- ===== 탭 [위치 · 속도] — ConfigTabBar 가 x:Name 으로 보이고 숨긴다. 콘텐츠 204 ~ 1056 ===== -->
    <Canvas x:Name="TabPosition" Canvas.Left="0" Canvas.Top="0" Width="1080" Height="1720">
    <!-- 지정 위치 — 이름·개수(최대 4)는 장비 설정 Config\Machine.xml(현장마다), 값(mm)은 Config\TeachPositions.xml. 수동조작 창 지정 위치 줄·대기 위치 타일과 같은 목록 -->
    <cnc:TeachPositionEditor Canvas.Left="204" Canvas.Top="12" Width="852" Height="468" access:Access.Level="5" MachineFile="Config\Machine.xml" TeachFile="Config\TeachPositions.xml" AxisLimits="X:-5:450;Y:-5:430;Z:-5:145" RowHeight="72" />

    <!-- ===== 속도 ===== -->
    <Border Canvas.Left="204" Canvas.Top="496" Width="852" Height="270" Style="{StaticResource Card}" />
    <TextBlock Canvas.Left="224" Canvas.Top="514" Style="{StaticResource CardTitle}" Text="속도" />
    <TextBlock Canvas.Left="224" Canvas.Top="584" Style="{StaticResource RowHead}" Text="수동 이동 속도" />
    <TextBlock Canvas.Left="224" Canvas.Top="606" Style="{StaticResource Caption}" Text="mm/s" />
    <ironControls:AnalogBox Canvas.Left="716" Canvas.Top="572" Width="320" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gEquipment.Input.Parameter.SystemSpeed" DecimalPlace="1" Min="1" Max="200" />
    <TextBlock Canvas.Left="224" Canvas.Top="684" Style="{StaticResource RowHead}" Text="속도 배율" />
    <TextBlock Canvas.Left="224" Canvas.Top="706" Style="{StaticResource Caption}" Text="%" />
    <ironControls:AnalogBox Canvas.Left="716" Canvas.Top="672" Width="320" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gEquipment.Input.Parameter.Feedrate" DecimalPlace="0" Min="0" Max="150" />

    <!-- ===== 축 소프트 리밋 ===== -->
    <Border Canvas.Left="204" Canvas.Top="778" Width="852" Height="372" Style="{StaticResource Card}" />
    <TextBlock Canvas.Left="224" Canvas.Top="796" Style="{StaticResource CardTitle}" Text="축 소프트 리밋" />
    <TextBlock Canvas.Left="352" Canvas.Top="799" Style="{StaticResource Caption}" Text="mm" />
    <TextBlock Canvas.Left="476" Canvas.Top="842" Style="{StaticResource ColHead}" Width="270" Text="− 쪽" />
    <TextBlock Canvas.Left="766" Canvas.Top="842" Style="{StaticResource ColHead}" Width="270" Text="+ 쪽" />
    <TextBlock Canvas.Left="224" Canvas.Top="890" Style="{StaticResource RowHead}" Text="X축" />
    <ironControls:AnalogBox Canvas.Left="476" Canvas.Top="870" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[0].Input.Parameter.SoftwareLimitsNeg" DecimalPlace="0" Min="-1000" Max="1000" />
    <ironControls:AnalogBox Canvas.Left="766" Canvas.Top="870" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[0].Input.Parameter.SoftwareLimitsPos" DecimalPlace="0" Min="-1000" Max="1000" />
    <TextBlock Canvas.Left="224" Canvas.Top="982" Style="{StaticResource RowHead}" Text="Y축" />
    <ironControls:AnalogBox Canvas.Left="476" Canvas.Top="962" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[1].Input.Parameter.SoftwareLimitsNeg" DecimalPlace="0" Min="-1000" Max="1000" />
    <ironControls:AnalogBox Canvas.Left="766" Canvas.Top="962" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[1].Input.Parameter.SoftwareLimitsPos" DecimalPlace="0" Min="-1000" Max="1000" />
    <TextBlock Canvas.Left="224" Canvas.Top="1074" Style="{StaticResource RowHead}" Text="Z축" />
    <ironControls:AnalogBox Canvas.Left="476" Canvas.Top="1054" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[2].Input.Parameter.SoftwareLimitsNeg" DecimalPlace="0" Min="-1000" Max="1000" />
    <ironControls:AnalogBox Canvas.Left="766" Canvas.Top="1054" Width="270" Height="64" Style="{StaticResource Edit}" Type="Output" KeyPadUse="True" ValueTag="::AsGlobalPV:gAxis[2].Input.Parameter.SoftwareLimitsPos" DecimalPlace="0" Min="-1000" Max="1000" />

    <!-- ===== 공작물 영점(G54~G57, PLC 대기 — 잠김) — 「헤드 · 좌표계」 탭이 「플러그인」이 되며 옮겼다 ===== -->
    <cnc:WorkOffsetCard Canvas.Left="204" Canvas.Top="1162" Width="852" Height="330" RowButtons="True" />
    </Canvas>

    <!-- ===== 탭 [플러그인] — 헤드 고르기(헤드는 하나) · 값 · PLC 지금 · 3D 모델 · M 코드 · 고급, 플러그인 배치(작업현황 4 × 4 칸 78 %), + 플러그인 추가. 예전 헤드 구성 · 헤드 테이블을 대신한다 ===== -->
    <Canvas x:Name="TabPlugin" Canvas.Left="0" Canvas.Top="0" Width="1080" Height="1720" Visibility="Collapsed">
    <cnc:PluginScreen Canvas.Left="204" Canvas.Top="12" Width="852" Height="1692" Portrait="True" opc:OpcUaNode.ConnectionId="cnc-plc" HeadsFile="Config\Heads.xml" UsageFile="Database\HeadUsage.xml" LayoutFile="Config\PluginLayout.xml" GCodeConfigFile="Config\GCode.xml" CncFolderFile="Config\CncFolder.xml" AccessLevel="10" CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction" MovingTag="::AsGlobalPV:gEquipment.Output.State.Move" ProgramNameTag="::AsGlobalPV:gEquipment.Input.Parameter.sProgramName" />
    </Canvas>

    <!-- ===== 탭 [시스템] — 장비 이름 기본 「범용 CNC」, 설정 · 다시 시작 ===== -->
    <Canvas x:Name="TabSystem" Canvas.Left="0" Canvas.Top="0" Width="1080" Height="1720" Visibility="Collapsed">
    <cnc:SystemSetupCard Canvas.Left="204" Canvas.Top="12" Width="852" Height="470" access:Access.Level="5" MachineFile="Config\Machine.xml" HeadsFile="Config\Heads.xml" AlarmsFile="alarms.json" Columns="2" InfoColumns="2" />
    <cnc:MaintenanceCard Canvas.Left="204" Canvas.Top="494" Width="852" Height="136" opc:OpcUaNode.ConnectionId="cnc-plc" AccessLevel="10" CurrentActionTag="::AsGlobalPV:gEquipment.Output.Status.CurrentAction" MovingTag="::AsGlobalPV:gEquipment.Output.State.Move" />
    </Canvas>

    <!-- 왼쪽 네비 — 위치 · 속도 / 플러그인 / 시스템, 칸을 누르면 위 세 Canvas 중 하나만 보인다 -->
    <cnc:ConfigTabBar Canvas.Left="24" Canvas.Top="12" Width="168" Height="208" Vertical="True" Labels="위치 · 속도|플러그인|시스템" Groups="TabPosition|TabPlugin|TabSystem" />
</Canvas>
